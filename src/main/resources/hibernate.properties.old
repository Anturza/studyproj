# Database connection settings
hibernate.connection.driver_class=org.postgresql.Driver
hibernate.connection.url=jdbc:postgresql://localhost:5432/postgres
hibernate.connection.username=postgres
hibernate.connection.password=qwerty

# Using built-in connection pool in study purposes
hibernate.connection.pool_size=1

# hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect doesn't need to specify explicitly

# Echo all executed SQL to console
hibernate.show_sql=true
hibernate.format_sql=true
hibernate.highlight_sql=true

# Automatically export the schema
hibernate.hbm2ddl.auto=update

